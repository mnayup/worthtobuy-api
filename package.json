{
  "name": "worthtobuy-api",
  "version": "1.0.0",
  "description": "WORTHTOBUY Backend API with NestJS, Prisma, and PostgreSQL",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate --config=./prisma/worthtobuy_db/prisma.config.ts",
    "prisma:push": "prisma db push --config=./prisma/worthtobuy_db/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config=./prisma/worthtobuy_db/prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config=./prisma/worthtobuy_db/prisma.config.ts",
    "prisma:studio": "prisma studio --config=./prisma/worthtobuy_db/prisma.config.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "googleapis": "^186.0.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.13",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "prisma": "^7.10.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
